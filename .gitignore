# Editor/agent configs
.claude/
.vscode/
.cursor/
.trae
.github/agents/

# Agent-internal development docs (kept on disk, not tracked)
docs/agent/

# Publication workspace. The *source* documents are tracked: they feed the
# method paper and the technical chapter, and keeping them untracked once cost
# us a corrected draft that lived only on one machine. What stays out is
# generated output and third-party material.
#
# Ignored inside docs/publication/:
#   reference/*.pdf, *.txt  — third-party published papers. Large, and not ours
#                             to redistribute. Keep on disk only.
#   html/, latex/outputs/,
#   latex/manuscript.pdf    — build products of build-html.py and pdflatex.
#   draft-superseded-*/     — dead copies retained pending manual deletion.
#
# Note these files are tracked but still NOT published on the docs site;
# mkdocs.yml excludes publication/ from the build.
docs/publication/reference/*.pdf
docs/publication/reference/*.txt
docs/publication/html/
docs/publication/latex/outputs/
docs/publication/latex/manuscript.pdf
docs/publication/draft-superseded-*/

# Generated site (mkdocs build output)
site/

# Dropbox conflicted copies
*conflicted copy*

# QA reference figures (binary, legacy location)
qa/reference_figures/

# Root example config
config.yaml

# Large extracted data (generated by example scripts)
examples/example_hsc_edgecases/data/
examples/example_hsc_edge_real/data/

# Reference implementation (excluded from install) — anchored to repo
# root so it does not catch `docs/reference/` or other nested folders.
/reference/

# Scratch directories
vibe/
temp/
.worktrees/

# Transient outputs (regenerated by scripts)
outputs/
!outputs/INVENTORY.md

# Generated image files
*.png
# The AASTeX ORCID badge is a build input the manuscript needs.
!docs/publication/latex/orcid-ID.png

